<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/colorSurface"
    android:fillViewport="true"
    tools:context=".GameModeActivity">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/main"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="20dp">

        <LinearLayout
            android:id="@+id/gameModeContent"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintWidth_max="560dp">

            <TextView
                android:id="@+id/gameModeTopicName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:ellipsize="end"
                android:maxLines="2"
                android:textColor="?attr/colorOnSurface"
                android:textSize="26sp"
                android:textStyle="bold"
                tools:text="Databases" />

            <TextView
                android:id="@+id/gameModeTopicDescription"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:gravity="center"
                android:text="@string/game_mode_subtitle"
                android:maxLines="2"
                android:ellipsize="end"
                android:textColor="?attr/colorOnSurfaceVariant"
                android:textSize="15sp" />

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                app:cardBackgroundColor="?attr/colorSurfaceContainerLow"
                app:cardCornerRadius="18dp"
                app:cardElevation="0dp"
                app:strokeColor="?attr/colorOutlineVariant"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="18dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/difficulty_title"
                        android:textColor="?attr/colorOnSurface"
                        android:textSize="18sp"
                        android:textStyle="bold" />

                    <HorizontalScrollView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:fillViewport="true"
                        android:scrollbars="none">

                        <com.google.android.material.button.MaterialButtonToggleGroup
                            android:id="@+id/difficultyGroup"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            app:selectionRequired="true"
                            app:singleSelection="true">

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/difficultyBasic"
                                style="@style/Widget.Material3.Button.OutlinedButton"
                                android:layout_width="wrap_content"
                                android:layout_height="48dp"
                                android:minWidth="100dp"
                                android:text="@string/difficulty_basic"
                                android:textSize="14sp"
                                android:maxLines="1"
                                android:ellipsize="end" />

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/difficultyCommon"
                                style="@style/Widget.Material3.Button.OutlinedButton"
                                android:layout_width="wrap_content"
                                android:layout_height="48dp"
                                android:minWidth="100dp"
                                android:text="@string/difficulty_common"
                                android:textSize="14sp"
                                android:maxLines="1"
                                android:ellipsize="end" />

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/difficultyAdvanced"
                                style="@style/Widget.Material3.Button.OutlinedButton"
                                android:layout_width="wrap_content"
                                android:layout_height="48dp"
                                android:minWidth="100dp"
                                android:text="@string/difficulty_advanced"
                                android:textSize="14sp"
                                android:maxLines="1"
                                android:ellipsize="end" />
                        </com.google.android.material.button.MaterialButtonToggleGroup>
                    </HorizontalScrollView>

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:text="@string/game_mode_currency_title"
                        android:textColor="?attr/colorOnSurface"
                        android:textSize="18sp"
                        android:textStyle="bold" />

                    <com.google.android.material.slider.Slider
                        android:id="@+id/currencySlider"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:contentDescription="@string/game_mode_currency_title"
                        android:stepSize="1"
                        android:value="3"
                        android:valueFrom="0"
                        android:valueTo="12"
                        app:labelBehavior="floating" />

                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:id="@+id/currencyLabels"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp">

                        <androidx.constraintlayout.widget.Guideline
                            android:id="@+id/currencyGuideQuarter"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            app:layout_constraintGuide_percent="0.26" />

                        <androidx.constraintlayout.widget.Guideline
                            android:id="@+id/currencyGuideHalf"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            app:layout_constraintGuide_percent="0.51" />

                        <androidx.constraintlayout.widget.Guideline
                            android:id="@+id/currencyGuideThreeQuarter"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            app:layout_constraintGuide_percent="0.75" />

                        <TextView
                            android:id="@+id/currencyLabel100"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:maxLines="1"
                            android:text="@string/currency_label_100"
                            android:textColor="?attr/colorOnSurfaceVariant"
                            android:textSize="11sp"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toTopOf="parent" />

                        <TextView
                            android:id="@+id/currencyLabel1k"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:maxLines="1"
                            android:text="@string/currency_label_1k"
                            android:textColor="?attr/colorOnSurfaceVariant"
                            android:textSize="11sp"
                            app:layout_constraintEnd_toEndOf="@+id/currencyGuideQuarter"
                            app:layout_constraintStart_toStartOf="@+id/currencyGuideQuarter"
                            app:layout_constraintTop_toTopOf="parent" />

                        <TextView
                            android:id="@+id/currencyLabel10k"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:maxLines="1"
                            android:text="@string/currency_label_10k"
                            android:textColor="?attr/colorOnSurfaceVariant"
                            android:textSize="11sp"
                            app:layout_constraintEnd_toEndOf="@+id/currencyGuideHalf"
                            app:layout_constraintStart_toStartOf="@+id/currencyGuideHalf"
                            app:layout_constraintTop_toTopOf="parent" />

                        <TextView
                            android:id="@+id/currencyLabel100k"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:maxLines="1"
                            android:text="@string/currency_label_100k"
                            android:textColor="?attr/colorOnSurfaceVariant"
                            android:textSize="11sp"
                            app:layout_constraintEnd_toEndOf="@+id/currencyGuideThreeQuarter"
                            app:layout_constraintStart_toStartOf="@+id/currencyGuideThreeQuarter"
                            app:layout_constraintTop_toTopOf="parent" />

                        <TextView
                            android:id="@+id/currencyLabel1m"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:maxLines="1"
                            android:text="@string/currency_label_1m"
                            android:textColor="?attr/colorOnSurfaceVariant"
                            android:textSize="11sp"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintTop_toTopOf="parent" />

                    </androidx.constraintlayout.widget.ConstraintLayout>

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="18dp"
                        android:text="@string/game_mode_choose_mode"
                        android:textColor="?attr/colorOnSurface"
                        android:textSize="18sp"
                        android:textStyle="bold" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:orientation="vertical">

                        <LinearLayout
                            android:id="@+id/gameModeSoloRow"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <RadioButton
                                android:id="@+id/radioModeSolo"
                                android:layout_width="0dp"
                                android:layout_height="48dp"
                                android:layout_weight="1"
                                android:checked="true"
                                android:text="@string/game_mode_solo"
                                android:textColor="?attr/colorOnSurface"
                                android:textSize="14sp"
                                android:maxLines="1"
                                android:ellipsize="end" />

                            <TextView
                                android:id="@+id/gameModeLimitsSolo"
                                android:layout_width="0dp"
                                android:layout_height="48dp"
                                android:layout_weight="1"
                                android:ellipsize="end"
                                android:gravity="end|center_vertical"
                                android:maxLines="1"
                                android:textAlignment="viewEnd"
                                android:textColor="?attr/colorOnSurfaceVariant"
                                android:textSize="12sp"
                                tools:text="15 questions • x2 • max 5K" />
                        </LinearLayout>

                        <LinearLayout
                            android:id="@+id/gameModePlayerRow"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <RadioButton
                                android:id="@+id/radioModePlayer"
                                android:layout_width="0dp"
                                android:layout_height="48dp"
                                android:layout_weight="1"
                                android:text="@string/game_mode_two_players"
                                android:textColor="?attr/colorOnSurface"
                                android:textSize="14sp"
                                android:maxLines="1"
                                android:ellipsize="end" />

                            <TextView
                                android:id="@+id/gameModeLimitsPlayer"
                                android:layout_width="0dp"
                                android:layout_height="48dp"
                                android:layout_weight="1"
                                android:ellipsize="end"
                                android:gravity="end|center_vertical"
                                android:maxLines="1"
                                android:textAlignment="viewEnd"
                                android:textColor="?attr/colorOnSurfaceVariant"
                                android:textSize="12sp"
                                tools:text="15 questions • x2 • max 1M" />
                        </LinearLayout>

                        <LinearLayout
                            android:id="@+id/gameModeComputerRow"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <RadioButton
                                android:id="@+id/radioModeComputer"
                                android:layout_width="0dp"
                                android:layout_height="48dp"
                                android:layout_weight="1"
                                android:text="@string/game_mode_computer"
                                android:textColor="?attr/colorOnSurface"
                                android:textSize="14sp"
                                android:maxLines="1"
                                android:ellipsize="end" />

                            <TextView
                                android:id="@+id/gameModeLimitsComputer"
                                android:layout_width="0dp"
                                android:layout_height="48dp"
                                android:layout_weight="1"
                                android:ellipsize="end"
                                android:gravity="end|center_vertical"
                                android:maxLines="1"
                                android:textAlignment="viewEnd"
                                android:textColor="?attr/colorOnSurfaceVariant"
                                android:textSize="12sp"
                                tools:text="15 questions • x2 • max 1K" />
                        </LinearLayout>

                    </LinearLayout>

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/buttonPlay"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:layout_marginBottom="12dp"
                android:text="@string/game_mode_play"
                android:textSize="16sp"
                app:cornerRadius="16dp" />

            <LinearLayout
                android:id="@+id/gameModeLoadingPanel"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="#80FFFFFF"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="4dp"
                android:visibility="gone">

                <ProgressBar
                    android:id="@+id/gameModeLoadingProgress"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />

                <TextView
                    android:id="@+id/gameModeLoadingText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="@string/game_mode_loading_match"
                    android:textColor="?attr/colorOnSurface"
                    android:textSize="14sp" />
            </LinearLayout>
        </LinearLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.core.widget.NestedScrollView>
