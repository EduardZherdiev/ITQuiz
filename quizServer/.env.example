# Local PostgreSQL
DATABASE_URL=postgresql+psycopg2://quiz:quiz@localhost:5432/quizdb_test
QUIZ_AUTH_SECRET=replace-with-a-long-random-secret
QUIZ_RESET_DB_ON_STARTUP=0
QUIZ_ENABLE_TEST_TOPUPS=1
QUIZ_ALLOWED_ORIGINS=http://localhost:3000
# Rewarded AdMob SSV validation (leave empty until a real AdMob unit is configured)
QUIZ_REWARDED_AD_UNIT_ID=
# Google Play Billing verification (keep the JSON file outside the repository)
GOOGLE_PLAY_PACKAGE_NAME=com.maxim.itquiz
GOOGLE_PLAY_SERVICE_ACCOUNT_FILE=
